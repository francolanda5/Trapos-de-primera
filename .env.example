# Copiá este archivo como .env.local para activar Supabase y el botón de Google.
# Todo es OPCIONAL: sin estas variables la app funciona igual, guardando los datos en LocalStorage.

# Supabase (base de datos y login): salen de Supabase > Connect > framework Vue.
# La publishable key es pública a propósito: los datos los protege la seguridad por filas (supabase/setup.sql).
# Nunca pongas acá la secret key ni la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Botón de Google SIN Supabase (Google Identity Services). Con Supabase activado no se usa.
# Cómo obtener el Client ID: ver GOOGLE_OAUTH.md
VITE_GOOGLE_CLIENT_ID=
